# Copy to .env.local and fill in your values
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/earnflow?retryWrites=true&w=majority
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Admin panel at /admin
# 1) Login to the site with this email first
# 2) Then open /admin (no login = no admin)
ADMIN_EMAIL=you@example.com
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional: real email via Resend (verify + cashout notices)
RESEND_API_KEY=
MAIL_FROM=EarnFlow <onboarding@resend.dev>

# Partner offerwall S2S postback secret
# AdGem: /api/offerwall/postback?uid=&coins=&txid=&secret=
OFFERWALL_SECRET=change-me-offerwall-secret

# PubScale S2S signature secret (from dashboard with App API key)
# Callback: /api/offerwall/postback?user_id=&value=&token=&signature=
# Falls back to OFFERWALL_SECRET if unset
PUBSCALE_SECRET=
